# ===========================================
# JSONKit Environment Variables
# ===========================================
# Copy this file to .env.local and fill in the values

# -------------------------------------------
# Google AdSense (Optional)
# -------------------------------------------
# Your Google AdSense Publisher ID
NEXT_PUBLIC_GOOGLE_ADSENSE_ID=ca-pub-0000000000000000

# -------------------------------------------
# Analytics (Optional)
# -------------------------------------------
# Google Analytics 4 Measurement ID (format: G-XXXXXXXXXX)
# When set, gtag.js is loaded and tool pages send anonymous `tool_use` events
# (tool, action, format/language, coarse size bucket). JSON content and other
# user input are never sent. Leave unset to disable GA entirely.
# Register `tool`, `action`, `result`, `from_format`, `to_format`, `language`,
# `mode` and `size_bucket` as event-scoped custom dimensions in GA4 to report on them.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# -------------------------------------------
# Site Configuration
# -------------------------------------------
# Base URL for the site (used for SEO, sitemap, and robots.txt)
NEXT_PUBLIC_BASE_URL=https://jsonkit.org

# -------------------------------------------
# Feature Flags (Optional)
# -------------------------------------------
# Enable/disable specific features
# NEXT_PUBLIC_ENABLE_ANALYTICS=true
# NEXT_PUBLIC_ENABLE_ADS=true
