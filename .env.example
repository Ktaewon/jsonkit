# ===========================================
# JSONKit Environment Variables
# ===========================================
# Copy this file to .env.local and fill in the values
#
# NEXT_PUBLIC_* values are inlined into the JS bundle and the prerendered HTML at
# build time. On Cloudflare Workers they cannot be changed with `wrangler secret`;
# rebuild and redeploy instead. `next build` also reads .env.local, so keep the
# AdSense ID out of it (or blank it in .env.production.local) for production builds.
# See DEPLOY_CLOUDFLARE.md.

# -------------------------------------------
# Google AdSense (Optional)
# -------------------------------------------
# Your Google AdSense Publisher ID. Leave empty in production (ads are off).
NEXT_PUBLIC_GOOGLE_ADSENSE_ID=

# -------------------------------------------
# Analytics (Optional)
# -------------------------------------------
# Google Analytics 4 Measurement ID (format: G-XXXXXXXXXX)
# When set, gtag.js is loaded and tool pages send anonymous `tool_use` events
# (tool, action, format/language, coarse size bucket). JSON content and other
# user input are never sent. Leave unset to disable GA entirely.
# Register `tool`, `action`, `result`, `from_format`, `to_format`, `language`,
# `mode` and `size_bucket` as event-scoped custom dimensions in GA4 to report on them.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# -------------------------------------------
# Site Configuration
# -------------------------------------------
# Base URL for the site (used for SEO, sitemap, and robots.txt)
NEXT_PUBLIC_BASE_URL=https://jsonkit.org

# -------------------------------------------
# Feature Flags (Optional)
# -------------------------------------------
# Enable/disable specific features
# NEXT_PUBLIC_ENABLE_ANALYTICS=true
# NEXT_PUBLIC_ENABLE_ADS=true

# -------------------------------------------
# Donation (Optional)
# -------------------------------------------
# Public donation page shown as a "Support" link in the footer. Must be https.
# Leave unset to hide the link. Donation page URLs are public by nature, so it is
# fine for them to end up in the client bundle; never put payment keys here.
# Global page (Buy Me a Coffee, Ko-fi, GitHub Sponsors, ...)
NEXT_PUBLIC_DONATION_URL=
# Optional page for Chinese visitors (/zh), e.g. Afdian with WeChat Pay / Alipay.
# Falls back to NEXT_PUBLIC_DONATION_URL when unset.
NEXT_PUBLIC_DONATION_URL_ZH=

# -------------------------------------------
# Vercel Blob (blog image upload script only)
# -------------------------------------------
# Used only by `node scripts/upload-blog-images.mjs`, run locally. Never needed by the
# deployed site; do not add it to Cloudflare.
BLOB_READ_WRITE_TOKEN=
