# ===========================================
# JSONKit Environment Variables
# ===========================================
# Copy this file to .env.local and fill in the values

# -------------------------------------------
# Google AdSense (Optional)
# -------------------------------------------
# Your Google AdSense Publisher ID
NEXT_PUBLIC_GOOGLE_ADSENSE_ID=ca-pub-0000000000000000

# -------------------------------------------
# Carbon Ads (Optional, BuySellAds network)
# -------------------------------------------
# When enabled with SERVE + PLACEMENT, Carbon loads in the header and
# Google AdSense head script is not injected (same-page exclusivity).
# Values come from your Carbon / BuySellAds publisher dashboard.
# NEXT_PUBLIC_CARBONADS_ENABLED=true
# NEXT_PUBLIC_CARBONADS_SERVE=CEXXXXXXXX
# NEXT_PUBLIC_CARBONADS_PLACEMENT=yourplacementname

# -------------------------------------------
# Analytics (Optional)
# -------------------------------------------
# Google Analytics Measurement ID
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# -------------------------------------------
# Site Configuration
# -------------------------------------------
# Base URL for the site (used for SEO, sitemap, and robots.txt)
NEXT_PUBLIC_BASE_URL=https://jsonkit.org

# -------------------------------------------
# Feature Flags (Optional)
# -------------------------------------------
# Enable/disable specific features
# NEXT_PUBLIC_ENABLE_ANALYTICS=true
# NEXT_PUBLIC_ENABLE_ADS=true
